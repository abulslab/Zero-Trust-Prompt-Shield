# Copy to .env (in the folder you start the API from) and fill in. Never commit .env.

# Optional: require this key on every /v1 call (send it as X-API-Key).
SHIELD_API_KEY=
# Optional: HMAC-SHA256 secret key for finding fingerprints (prevents rainbow-table lookup of low-entropy values).
SHIELD_FINGERPRINT_KEY=

# Model provider for semantic review, prompt optimisation and the guard: none | gemini | ollama | anthropic | openai
SHIELD_AI_PROVIDER=none
# Seconds per model call: default 30 for hosted providers, 180 for Ollama.
SHIELD_AI_TIMEOUT_S=
GEMINI_API_KEY=
SHIELD_GEMINI_MODEL=gemini-3.5-flash
SHIELD_OLLAMA_URL=http://localhost:11434
SHIELD_OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SHIELD_OPENAI_BASE_URL=https://api.openai.com/v1

# Service
SHIELD_DEFAULT_POLICY=balanced
SHIELD_POLICY_DIR=
SHIELD_DB_PATH=data/promptshield.db
SHIELD_MAX_CHARS=200000
SHIELD_RATE_LIMIT_PER_MINUTE=240
